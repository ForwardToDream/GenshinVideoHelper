<Window x:Class="GenshinVideoHelper.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:controls="clr-namespace:GenshinVideoHelper.App.Controls"
 Icon="/GenshinVideoHelper;component/Resources/AppIcon.ico" Title="GenshinVideoHelper · 视频跟随助手" Width="1020" Height="730" MinWidth="860" MinHeight="600"
 Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Border Background="{StaticResource PageBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
   <Border Background="{StaticResource TitleBarBrush}" CornerRadius="5,5,0,0">
    <Grid>
     <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
      <Image Source="/GenshinVideoHelper;component/Resources/AppIcon.png" Width="24" Height="24" Margin="0,0,10,0" />
      <TextBlock Text="GenshinVideoHelper" Foreground="White" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="原神视频跟随" Foreground="#DFEEFF" FontSize="12" Margin="14,2,0,0" VerticalAlignment="Center" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
      <TextBlock x:Name="HeaderConnectionState" Text="等待开始" Foreground="#DFEEFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
      <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化到系统托盘" AutomationProperties.Name="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Style="{StaticResource Symbol}" Text="&#xE921;" Foreground="White" FontSize="12" /></Button>
      <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Style="{StaticResource Symbol}" Text="&#xE922;" Foreground="White" FontSize="12" /></Button>
      <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="退出并关闭浏览器与画中画" AutomationProperties.Name="关闭工具" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Style="{StaticResource Symbol}" Text="&#xE8BB;" Foreground="White" FontSize="12" /></Button>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,16,0,0">
       <TextBlock Text="视频跟随" Style="{StaticResource SecondaryText}" Margin="20,0,0,9" />
       <RadioButton x:Name="NavFollow" Style="{StaticResource NavItem}" GroupName="Navigation" Tag="Follow" IsChecked="True" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Symbol}" Text="&#xE768;" Margin="0,0,13,0" /><TextBlock Text="启动" VerticalAlignment="Center" /></StackPanel></RadioButton>
       <RadioButton x:Name="NavProgress" Style="{StaticResource NavItem}" GroupName="Navigation" Tag="Progress" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Symbol}" Text="&#xE73A;" Margin="0,0,13,0" /><TextBlock Text="进度" VerticalAlignment="Center" /></StackPanel></RadioButton>
       <RadioButton x:Name="NavVision" Style="{StaticResource NavItem}" GroupName="Navigation" Tag="Vision" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Symbol}" Text="&#xE707;" Margin="0,0,13,0" /><TextBlock Text="地图识别" VerticalAlignment="Center" /></StackPanel></RadioButton>
       <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" GroupName="Navigation" Tag="Hotkeys" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Symbol}" Text="&#xE765;" Margin="0,0,13,0" /><TextBlock Text="快捷键" VerticalAlignment="Center" /></StackPanel></RadioButton>
       <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Navigation" Tag="Settings" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Symbol}" Text="&#xE713;" Margin="0,0,13,0" /><TextBlock Text="设置" VerticalAlignment="Center" /></StackPanel></RadioButton>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
     <StackPanel Margin="24,20,24,18"><TextBlock x:Name="PageHeading" Text="启动" Style="{StaticResource PageTitle}" /><TextBlock x:Name="PageDescription" Text="选择攻略，自动播放并进入左下角画中画。" Style="{StaticResource SecondaryText}" /></StackPanel>
     <Grid x:Name="PagesHost" Grid.Row="1">
      <ScrollViewer x:Name="VisionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="24,0,24,20">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="小地图跟随" Style="{StaticResource CardTitle}" />
         <CheckBox x:Name="VisionEnabled" Content="跟随时自动识别地图" Checked="VisionOptions_Changed" Unchecked="VisionOptions_Changed" />
         <TextBlock Text="点击开始跟随后自动标记原神小地图，无需选择窗口。切出游戏时暂停识别。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,12" />
         <TextBlock x:Name="VisionStatus" Text="开始跟随后自动识别" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" />
         <TextBlock x:Name="VisionMetrics" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="性能与显示" Style="{StaticResource CardTitle}" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="更新间隔" /><TextBlock Text="默认 100ms（10 次/秒），数值越大越省 CPU" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
          <ComboBox x:Name="VisionInterval" Grid.Column="1" SelectionChanged="VisionOptions_Changed" Margin="12,0,0,0">
           <ComboBoxItem Content="50 ms · 20 次/秒" Tag="50" /><ComboBoxItem Content="100 ms · 10 次/秒" Tag="100" /><ComboBoxItem Content="150 ms · 约 7 次/秒" Tag="150" /><ComboBoxItem Content="200 ms · 5 次/秒" Tag="200" />
          </ComboBox>
         </Grid>
         <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="圆盘重搜索间隔" /><TextBlock Text="地图消失或布局变化时生效" Style="{StaticResource SecondaryText}" /></StackPanel>
          <ComboBox x:Name="VisionSearchInterval" Grid.Column="1" SelectionChanged="VisionOptions_Changed" Margin="12,0,0,0"><ComboBoxItem Content="1 秒" Tag="1000" /><ComboBoxItem Content="2 秒" Tag="2000" /><ComboBoxItem Content="3 秒" Tag="3000" /></ComboBox>
         </Grid>
         <CheckBox x:Name="VisionDirection" Content="显示可信视线方向" Checked="VisionOptions_Changed" Unchecked="VisionOptions_Changed" Margin="0,18,0,0" />
         <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
          <TextBlock Text="标记大小" VerticalAlignment="Center" />
          <ComboBox x:Name="VisionMarkerSize" Grid.Column="1" SelectionChanged="VisionOptions_Changed" Margin="12,0,0,0"><ComboBoxItem Content="小" Tag="3" /><ComboBoxItem Content="标准" Tag="5" /><ComboBoxItem Content="大" Tag="7" /><ComboBoxItem Content="特大" Tag="9" /></ComboBox>
         </Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="识别条件" Style="{StaticResource CardTitle}" />
         <TextBlock Text="两端小地图需位于画面左上四分之一，且有重叠地形。建议将指导视频切到 1080p。地图全黑、缺失、区域不符或结果过期时不显示标记；视线不可靠时只显示圆点。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
         <TextBlock Text="圆点颜色根据附近地形自动调整。暂时隐藏画中画仍可识别，主动关闭画中画后停止标记。建议游戏使用无边框窗口模式。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="FollowPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="24,0,24,20">
        <Border Style="{StaticResource Card}"><StackPanel>
         <Grid Margin="0,0,0,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="GuideCardTitle" Text="攻略选择" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
          <Button x:Name="ChangeLibraryButton" Grid.Column="1" Content="更换库" Style="{StaticResource SubtleButton}" Padding="12,4" MinHeight="28" Click="ChangeLibrary_Click" Margin="12,0,0,0" />
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <TextBlock x:Name="LibrarySummaryText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <TextBlock x:Name="LibraryVideoCountText" Grid.Column="1" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
         </Grid>
         <ComboBox x:Name="GuideVideoSelector" SelectionChanged="GuideVideoSelector_SelectionChanged" Margin="0,0,0,8" ToolTip="从库中选择地图攻略，也可在下面自行输入链接" AutomationProperties.Name="地图攻略视频">
          <ComboBox.ItemTemplate><DataTemplate><DockPanel>
           <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"><TextBlock.Text><MultiBinding Converter="{StaticResource ProgressLookup}"><Binding /><Binding Source="{StaticResource ProgressLookup}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
           <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}" />
          </DockPanel></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox>
         <TextBox x:Name="UrlInput" Height="36" KeyDown="UrlInput_KeyDown" TextChanged="UrlInput_TextChanged" ToolTip="直接清空或改写链接即可自行输入；支持 BV 号和 ?p=3，自动读取分集" />
         <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ComboBox x:Name="EpisodeSelector" MinWidth="100" IsEnabled="False" SelectionChanged="EpisodeSelector_SelectionChanged" ToolTip="开始前可预选分 P；跟随当前视频时直接切换分集"><ComboBox.ItemTemplate><DataTemplate><DockPanel>
           <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"><TextBlock.Text><MultiBinding Converter="{StaticResource ProgressLookup}"><Binding /><Binding Source="{StaticResource ProgressLookup}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
           <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}" />
          </DockPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button x:Name="PreviousEpisodeButton" Grid.Column="1" Content="上一集" Margin="10,0,0,0" IsEnabled="False" Click="PreviousEpisode_Click" />
          <Button x:Name="NextEpisodeButton" Grid.Column="2" Content="下一集" Margin="8,0,0,0" IsEnabled="False" Click="NextEpisode_Click" />
         </Grid>
         <Button x:Name="OpenButton" Content="开始跟随" Style="{StaticResource PrimaryButton}" MinHeight="40" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OpenVideo_Click" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="EpisodeStatusText" Margin="0,8,0,0" VerticalAlignment="Center">
           <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
          <Button x:Name="EpisodeRetryButton" Grid.Column="1" Content="重试分集" Padding="10,4" MinHeight="28" VerticalAlignment="Center" Margin="12,8,0,0" Visibility="Collapsed" Click="EpisodeRetry_Click" />
         </Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="播放控制" Style="{StaticResource CardTitle}" Margin="0" />
          <Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="3" Padding="10,4"><TextBlock x:Name="PlaybackLabel" Text="未连接" Foreground="{StaticResource AccentBrush}" FontSize="12" /></Border>
         </Grid>
         <TextBlock x:Name="VideoTitle" Text="等待开始跟随" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
         <TextBlock x:Name="TimeLabel" Text="--:-- / --:--" FontSize="27" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,8" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Content="后退 5 秒" Click="Backward_Click" Margin="0,0,6,0" ToolTip="Alt + 1" />
          <Button x:Name="PlayButton" Grid.Column="1" Content="播放 / 暂停" Style="{StaticResource PrimaryButton}" Click="Toggle_Click" Margin="6,0" ToolTip="Alt + 2" />
          <Button x:Name="ForwardButton" Grid.Column="2" Content="前进 5 秒" Click="Forward_Click" Margin="6,0,0,0" ToolTip="Alt + 3" />
         </Grid>
         <DockPanel Margin="0,11,0,0">
          <TextBlock x:Name="WatchProgressText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" ToolTip="只统计真正播放过的部分；可在“进度”页查看和修改" />
          <TextBlock x:Name="PlaybackPreferenceText" Text="跳转步长 5 秒 · 播放速度 1×" Style="{StaticResource SecondaryText}" />
         </DockPanel>
         <Separator Margin="0,12,0,12" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PipStateText" Text="就绪后自动开启浮窗" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
           <Button x:Name="PipButton" Content="开启画中画" Padding="12,6" MinHeight="30" Click="Pip_Click" />
           <Button Content="放回左下角" Padding="12,6" MinHeight="30" Margin="8,0,0,0" Click="PlacePip_Click" />
           <Button x:Name="MuteButton" Content="静音" Style="{StaticResource SubtleButton}" Padding="12,6" MinHeight="30" Margin="8,0,0,0" Click="Mute_Click" />
          </StackPanel>
         </Grid>
         <Button x:Name="FollowRetryButton" Content="重试自动跟随" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,13,0,0" Visibility="Collapsed" Click="FollowRetry_Click" />
        </StackPanel></Border>
        <TextBlock Text="保留 Chrome 视频页面。推荐游戏使用无边框窗口，最小化工具后快捷键继续生效。" Style="{StaticResource SecondaryText}" Margin="3,0,3,0" />
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="24,0,24,20">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="播放与浮窗" Style="{StaticResource CardTitle}" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,15,0"><TextBlock Text="前进 / 后退步长" Margin="0,0,0,5" /><TextBlock Text="按钮与前进 / 后退快捷键共用此步长。" Style="{StaticResource SecondaryText}" /></StackPanel>
          <ComboBox x:Name="SeekSelector" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Seek_Changed"><ComboBoxItem Content="5 秒" Tag="5" /><ComboBoxItem Content="10 秒" Tag="10" /><ComboBoxItem Content="15 秒" Tag="15" /></ComboBox>
         </Grid>
         <Separator Margin="0,18,0,18" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,15,0"><TextBlock Text="播放速度" Margin="0,0,0,5" /><TextBlock Text="作用于当前连接的视频。" Style="{StaticResource SecondaryText}" /></StackPanel>
          <ComboBox x:Name="RateSelector" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Rate_Changed"><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.5×" Tag="1.5" /><ComboBoxItem Content="2×" Tag="2" /></ComboBox>
         </Grid>
         <Separator Margin="0,18,0,18" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="65" /></Grid.ColumnDefinitions>
          <TextBlock Text="浮窗宽度" VerticalAlignment="Center" />
          <Slider x:Name="PipWidthSlider" Grid.Column="1" Minimum="280" Maximum="800" TickFrequency="20" IsSnapToTickEnabled="True" Margin="12,0,15,0" VerticalAlignment="Center" ValueChanged="PipWidth_Changed" />
          <TextBlock x:Name="PipWidthLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
         </Grid>
         <TextBlock Text="按视频比例调整高度。改宽度后点击启动页“放回左下角”应用；下次自动开启也会使用新宽度。" Style="{StaticResource SecondaryText}" Margin="0,11,0,0" />
        </StackPanel></Border>
        <StackPanel Margin="3,0,3,0">
         <TextBlock x:Name="ConfigPathText" Style="{StaticResource SecondaryText}" Margin="0,0,0,10" />
         <WrapPanel><Button Content="使用说明" Click="OpenReadme_Click" Padding="12,6" MinHeight="30" Margin="0,0,8,9" /><Button Content="PCL 源仓库" Tag="https://github.com/Meloong-Git/PCL" Click="OpenLink_Click" Padding="12,6" MinHeight="30" Margin="0,0,8,9" /><Button Content="BGI 源仓库" Tag="https://github.com/babalae/better-genshin-impact" Click="OpenLink_Click" Padding="12,6" MinHeight="30" Margin="0,0,8,9" /></WrapPanel>
         <TextBlock Text="视觉参考：Plain Craft Launcher · 龙腾猫跃。技术与组织参考：Better Genshin Impact · babalae 及贡献者。" Style="{StaticResource SecondaryText}" />
         <TextBlock Text="本软件独立开发，与参考项目官方无关联。小地图识别尚未接入。" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
      <Grid x:Name="ProgressPage" Visibility="Collapsed" Margin="24,0,24,20">
       <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="12,14,12,10" Margin="0,0,12,12">
         <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
           <TextBlock x:Name="ProgressLibraryText" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <TextBlock x:Name="ProgressTotalText" Style="{StaticResource SecondaryText}" Margin="0,4,0,7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <ProgressBar x:Name="ProgressTotalBar" AutomationProperties.Name="总体进度" />
          </StackPanel>
          <ListBox x:Name="ProgressVideoList" Style="{StaticResource LibraryPickerList}" ItemContainerStyle="{StaticResource CompactListItem}" SelectionChanged="ProgressVideoList_SelectionChanged" AutomationProperties.Name="地图列表">
           <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
            <TextBlock Text="{Binding Name}" Margin="4,8,0,5"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
           <ListBox.ItemTemplate><DataTemplate><StackPanel>
            <DockPanel>
             <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
             <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
            </DockPanel>
            <ProgressBar Value="{Binding Ratio, Mode=OneWay}" Height="3" Margin="0,6,0,0" />
           </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
         </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,14,14,10" Margin="0,0,0,12">
         <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
           <DockPanel>
            <TextBlock x:Name="ProgressVideoCountText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" TextWrapping="NoWrap" />
            <TextBlock x:Name="ProgressVideoTitle" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           </DockPanel>
           <WrapPanel x:Name="ProgressBulkPanel" Margin="0,8,0,-5">
            <Button x:Name="ProgressCompleteBeforeButton" Content="此集之前全部完成" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressCompleteBefore_Click" ToolTip="把所选分集之前的全部分集标记为已完成，适合已经跟了一段再开始记录的情况" />
            <Button x:Name="ProgressCompleteAllButton" Content="整张标记完成" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressCompleteAll_Click" />
            <Button x:Name="ProgressResetVideoButton" Content="重置整张地图" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressResetVideo_Click" />
           </WrapPanel>
           <Border x:Name="ProgressConfirmPanel" Style="{StaticResource Notice}" Padding="11,6" Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
             <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
              <Button x:Name="ProgressConfirmButton" Content="确认" Style="{StaticResource SmallPrimaryButton}" Margin="0,0,7,0" Click="ProgressConfirm_Click" />
              <Button x:Name="ProgressCancelButton" Content="取消" Style="{StaticResource SmallSubtleButton}" Click="ProgressCancel_Click" />
             </StackPanel>
             <TextBlock x:Name="ProgressConfirmText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
           </Border>
          </StackPanel>
          <Grid>
           <ListBox x:Name="ProgressEpisodeList" Style="{StaticResource LibraryPickerList}" ItemContainerStyle="{StaticResource CompactListItem}" SelectionChanged="ProgressEpisodeList_SelectionChanged" AutomationProperties.Name="分集进度">
            <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Detail}">
             <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition /><ColumnDefinition Width="104" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
             <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="1.5" />
             <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding CheckVisibility}" />
             <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
             <controls:WatchTimeline Grid.Column="2" Height="7" Margin="10,0,8,0" VerticalAlignment="Center" Segments="{Binding Segments}" Duration="{Binding Duration}" TrackBrush="{StaticResource BorderBrush}" WatchedBrush="{StaticResource PrimaryBrush}" />
             <Border Grid.Column="3" Style="{StaticResource Keycap}" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding ManualVisibility}"><TextBlock Text="手动" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
             <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid></DataTemplate></ListBox.ItemTemplate>
           </ListBox>
           <TextBlock x:Name="ProgressEmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12" Visibility="Collapsed" />
          </Grid>
         </DockPanel>
        </Border>
       </Grid>
       <Border x:Name="ProgressEditor" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12,16,7" Margin="0">
        <StackPanel>
         <DockPanel>
          <TextBlock x:Name="ProgressEditorState" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" TextWrapping="NoWrap" />
          <TextBlock x:Name="ProgressEditorTitle" Text="选择一个分集查看和修改进度" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
         </DockPanel>
         <controls:WatchTimeline x:Name="ProgressTimeline" Height="24" Margin="0,9,0,3" IsInteractive="True" Cursor="Hand" SelectionChanged="ProgressTimeline_SelectionChanged"
                                 TrackBrush="{StaticResource BorderBrush}" WatchedBrush="{StaticResource PrimaryBrush}" SelectionBrush="{StaticResource WarningBrush}" MarkerBrush="{StaticResource TextBrush}"
                                 ToolTip="蓝色是已看的部分，竖线是续播点。拖动选出一段，点击选一个时间点" AutomationProperties.Name="分集时间轴" />
         <DockPanel>
          <TextBlock x:Name="ProgressTimelineEnd" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
          <TextBlock Text="00:00" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
         </DockPanel>
         <WrapPanel Margin="0,6,0,0">
          <TextBlock Text="选区" VerticalAlignment="Center" Margin="0,0,7,5" />
          <TextBox x:Name="ProgressRangeStart" Width="70" Padding="8,5" Margin="0,0,5,5" TextChanged="ProgressRange_TextChanged" AutomationProperties.Name="选区开始时间" ToolTip="开始时间，例如 3:20" />
          <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,5,5" />
          <TextBox x:Name="ProgressRangeEnd" Width="70" Padding="8,5" Margin="0,0,7,5" TextChanged="ProgressRange_TextChanged" AutomationProperties.Name="选区结束时间" ToolTip="结束时间，例如 8:45" />
          <Button x:Name="ProgressMarkWatchedButton" Content="标记已看" Style="{StaticResource SmallButton}" Margin="0,0,7,5" Click="ProgressMarkWatched_Click" />
          <Button x:Name="ProgressMarkUnwatchedButton" Content="标记未看" Style="{StaticResource SmallButton}" Margin="0,0,18,5" Click="ProgressMarkUnwatched_Click" />
          <TextBlock Text="续播点" VerticalAlignment="Center" Margin="0,0,7,5" />
          <TextBox x:Name="ProgressPositionInput" Width="70" Padding="8,5" Margin="0,0,7,5" KeyDown="ProgressPositionInput_KeyDown" AutomationProperties.Name="续播位置" ToolTip="下次开始跟随时跳到这里，例如 12:34" />
          <Button x:Name="ProgressSetPositionButton" Content="设为续播点" Style="{StaticResource SmallButton}" Margin="0,0,0,5" Click="ProgressSetPosition_Click" />
         </WrapPanel>
         <WrapPanel Margin="0,2,0,0">
          <Button x:Name="ProgressCompleteButton" Content="标记完成" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressComplete_Click" />
          <Button x:Name="ProgressIncompleteButton" Content="标记未完成" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressIncomplete_Click" ToolTip="固定为未完成，之后看完也不会自动完成，直到恢复自动判定" />
          <Button x:Name="ProgressAutoButton" Content="恢复自动判定" Style="{StaticResource SmallSubtleButton}" Margin="0,0,7,5" Click="ProgressAuto_Click" />
          <Button x:Name="ProgressResetEpisodeButton" Content="重置本集" Style="{StaticResource SmallSubtleButton}" Margin="0,0,18,5" Click="ProgressResetEpisode_Click" />
          <Button x:Name="ProgressFollowButton" Content="从这一集开始跟随" Style="{StaticResource SmallPrimaryButton}" Margin="0,0,18,5" Click="ProgressFollow_Click" />
          <Button x:Name="ProgressUndoButton" Content="撤销" Style="{StaticResource SmallSubtleButton}" Margin="0,0,0,5" IsEnabled="False" Click="ProgressUndo_Click" />
         </WrapPanel>
        </StackPanel>
       </Border>
      </Grid>
      <Grid x:Name="HotkeysPage" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="24,0,24,20">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="全局快捷键" Style="{StaticResource CardTitle}" />
         <CheckBox x:Name="HotkeysCheckbox" Content="启用全局快捷键" Click="Hotkeys_Click" />
         <TextBlock x:Name="HotkeyStatus" Text="启动后注册快捷键" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,11,0,0" />
         <TextBlock Text="修改组合键后点击“保存绑定”。支持 Ctrl、Alt、Shift、Win 加字母、数字、方向键或 F1–F24；点击“录入”可直接按键，Esc 取消。显隐模式支持单键（~ / 反引号键等），按一下切换，长按不重复。编辑期间暂时停用全局快捷键。" Style="{StaticResource SecondaryText}" Margin="0,12,0,16" />
         <ItemsControl x:Name="HotkeyRows"><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,15,0"><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="11" /></StackPanel>
           <TextBox Grid.Column="1" Text="{Binding Keys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" GotKeyboardFocus="Binding_GotKeyboardFocus" LostKeyboardFocus="Binding_LostKeyboardFocus" PreviewKeyDown="Binding_PreviewKeyDown" ToolTip="例如 Alt+Left 或 Ctrl+Shift+F8" />
           <Button Grid.Column="2" Content="录入" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center" Click="CaptureBinding_Click" />
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
       </StackPanel>
       </ScrollViewer>
       <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,20" Padding="18,12"><StackPanel>
        <WrapPanel><Button Content="保存绑定" Style="{StaticResource PrimaryButton}" Click="SaveBindings_Click" Margin="0,0,10,0" /><Button Content="填入默认绑定" Click="ResetBindings_Click" /></WrapPanel>
        <TextBlock x:Name="BindingStatus" Text="录入或填写组合键，保存后立即生效并写入根目录配置。" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
       </StackPanel></Border>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="White" CornerRadius="0,0,5,5">
    <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="粘贴攻略链接，点击开始跟随。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
     <TextBlock Grid.Column="1" Text="基础版" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0" />
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
