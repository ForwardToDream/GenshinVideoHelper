<Window x:Class="GenshinVideoHelper.App.PipFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="画中画" Width="422" Height="262" MinWidth="202" MinHeight="140"
        WindowStyle="None" ResizeMode="CanResize" Background="#1370F3"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="25" ResizeBorderThickness="5" GlassFrameThickness="0"
                       CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GenshinVideoHelper;component/Resources/PclTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid x:Name="ModeBar" Background="{StaticResource TitleBarBrush}" ToolTip="拖动横条或视频移动浮窗；拖动边缘调整大小">
        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="14" Height="14">
            <Path x:Name="LockIcon" Data="M4,6.5 V4 A3,3 0 0 1 10,4 V6.5 M3,6.5 H11 V13 H3 Z M7,9 V11"
                  Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Ellipse x:Name="CircleIcon" Width="10" Height="10" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
            <Path x:Name="MouseIcon" Data="M7,1 C4,1 3,3 3,5 V9 C3,12 5,13 7,13 C9,13 11,12 11,9 V5 C11,3 10,1 7,1 Z M7,3 V6"
                  Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/>
          </Grid>
        </Viewbox>
        <Button x:Name="CloseVideoButton" HorizontalAlignment="Right" Width="28" Height="24" MinHeight="0" MinWidth="0" Padding="0" VerticalAlignment="Center" Focusable="False"
                Style="{StaticResource CaptionButton}" Click="CloseVideo_Click" ToolTip="关闭画中画"
                AutomationProperties.Name="关闭画中画" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"/>
        </Button>
      </Grid>
      <Border x:Name="VideoSlot" Grid.Row="1" Background="Black" MouseLeftButtonDown="Video_MouseLeftButtonDown"/>
    </Grid>
  </Border>
</Window>
