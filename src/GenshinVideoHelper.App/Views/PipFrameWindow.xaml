<Window x:Class="GenshinVideoHelper.App.PipFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画中画状态" Width="420" Height="24"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GenshinVideoHelper;component/Resources/PclTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="{StaticResource TitleBarBrush}" CornerRadius="5,5,0,0">
    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="14" Height="14">
        <Path x:Name="LockIcon" Data="M4,6.5 V4 A3,3 0 0 1 10,4 V6.5 M3,6.5 H11 V13 H3 Z M7,9 V11"
              Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round" Visibility="Collapsed"/>
        <Ellipse x:Name="CircleIcon" Width="10" Height="10" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
        <Path x:Name="MouseIcon" Data="M7,1 C4,1 3,3 3,5 V9 C3,12 5,13 7,13 C9,13 11,12 11,9 V5 C11,3 10,1 7,1 Z M7,3 V6"
              Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/>
      </Grid>
    </Viewbox>
  </Border>
</Window>
