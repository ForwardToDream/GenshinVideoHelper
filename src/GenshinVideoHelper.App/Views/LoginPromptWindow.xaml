<Window x:Class="GenshinVideoHelper.App.LoginPromptWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="登录以解锁高清" Width="450" Height="245" MinWidth="400" MinHeight="245"
 WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PageBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="{StaticResource TitleBarBrush}" CornerRadius="5,5,0,0"><DockPanel Margin="18,0,5,0">
    <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="Continue_Click" ToolTip="继续匿名跟随" AutomationProperties.Name="关闭登录提示" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Style="{StaticResource Symbol}" Text="&#xE8BB;" Foreground="White" FontSize="12" /></Button>
    <TextBlock Text="登录以解锁高清" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
   </DockPanel></Border>
   <StackPanel Grid.Row="1" Margin="22,20,22,12">
    <TextBlock Text="当前尚未登录 B 站账号" FontWeight="SemiBold" FontSize="16" />
    <TextBlock Text="登录账号以解锁高清画质。你也可以继续匿名跟随。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" />
   </StackPanel>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,0,22,20">
    <Button x:Name="ContinueButton" Content="继续跟随" Margin="0,0,10,0" Click="Continue_Click" />
    <Button x:Name="LoginButton" Content="去登录" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True" />
   </StackPanel>
  </Grid>
 </Border>
</Window>
